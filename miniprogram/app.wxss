/* ============================================================
   全局样式 —— 「成绩单公报」设计语言 R3
   设计简报: design/brief.md · 评审记录: design/DESIGN-RECORD.md
   结构原则: 连续纸面 + 发丝线分区（隐喻进结构层，不做卡片堆）
   排印纪律: 四级字阶 + 行情数字规范（衬线加粗 tnum, 单位降灰）
   色彩纪律: 单色墨绿 / 印章红仅认证印与「重试」动作 / AA 对比度
   ============================================================ */

page {
  /* —— 纸与墨 —— */
  --paper: #F7F4EC;          /* 页面底: 米白纸 */
  --paper-deep: #ECE7DA;     /* 输入井 */
  --ink: #1F2A26;            /* 正文: 近黑墨色 (~12:1) */
  --ink-green: #175243;      /* 主色: 墨绿 (~7.6:1) */
  --ink-soft: #57534A;       /* 次级文字 (~7:1) */
  --ink-faint: #6C6659;      /* 弱化文字, 仅用于 ≥22rpx (~4.6:1) */
  --line: #D9D3C2;           /* 发丝线 */
  --line-strong: #B9B2A0;    /* 强分隔线 */
  --seal: #B5442D;           /* 印章红: 仅认证印与「重试」动作 */

  /* —— 字体栈 —— */
  --serif: 'Songti SC', 'STSong', 'Noto Serif SC', 'SimSun', serif;
  --mono: 'SF Mono', 'Menlo', 'Consolas', 'Courier New', monospace;

  /* —— 字阶（四级, 全局纪律）—— */
  --fs-display: 52rpx;  /* 刊头宋体 */
  --fs-name: 34rpx;     /* 条目姓名宋体 */
  --fs-body: 28rpx;     /* 正文 */
  --fs-sub: 24rpx;      /* 说明/meta */
  --fs-label: 22rpx;    /* 标签(需配字距) */

  background-color: var(--paper);
  color: var(--ink);
  font-size: var(--fs-body);
  line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* ---------- 字体工具 ---------- */
.serif { font-family: var(--serif); }
.mono  { font-family: var(--mono); }

/* ---------- 行情数字规范（全局唯一数字规格: 油墨黑, 绿色仅留给主操作） ---------- */
.num {
  font-family: var(--serif);
  font-weight: 900;
  color: var(--ink);
  font-size: 30rpx;
  letter-spacing: 0;
  font-feature-settings: 'tnum';
}
.num-unit {
  font-size: var(--fs-label);
  font-weight: 400;
  color: var(--ink-faint);
  margin-left: 4rpx;
  letter-spacing: 0;
}

/* ---------- 公报报头 ---------- */
.masthead {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 4rpx 22rpx;
  border-bottom: 8rpx double var(--ink-green);
}
.masthead-title {
  font-family: var(--serif);
  font-size: var(--fs-display);
  font-weight: 900;
  letter-spacing: 12rpx;
  color: var(--ink-green);
}
.masthead-issue {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-soft);
}

/* ---------- 小节标题: 宋体字距 + 尾随发丝线 (账目 rubric) ---------- */
.sec-title {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-family: var(--serif);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}
.sec-title::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line-strong);
}

/* ---------- 科目标签: 铅字直角排印【数学】 ---------- */
.subj {
  font-size: var(--fs-sub);
  color: var(--ink-green);
  letter-spacing: 1rpx;
}

/* ---------- 印章徽章: 印形制 (内框线), 仅认证, 全站唯一写法 ---------- */
.seal-badge {
  display: inline-block;
  background: var(--seal);
  color: #FBF7EF;
  font-family: var(--serif);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 4rpx 10rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 2rpx rgba(251, 247, 239, 0.4);
}

/* ---------- 单字篆印头像占位 (白文印) ---------- */
.seal-ava {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--seal);
  color: #FBF7EF;
  font-family: var(--serif);
  font-weight: 900;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 3rpx rgba(251, 247, 239, 0.35);
}

/* ---------- 档案照框 (照片型头像, 必有图像) ---------- */
.photo-frame {
  padding: 4rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--paper);
  box-sizing: content-box;
}
.photo-frame image {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---------- 文字动作 (检索行尾, 激活带印红点) ---------- */
.text-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
  color: var(--ink-green);
  font-size: var(--fs-sub);
  letter-spacing: 4rpx;
}
.text-action.active::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background: var(--seal);
  border-radius: 50%;
  margin-right: 10rpx;
}

/* ---------- 按钮: 方角铅字 ---------- */
.btn {
  font-size: var(--fs-body);
  letter-spacing: 2rpx;
  border-radius: 2rpx;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--ink-green);
  color: var(--paper);
}
.btn-primary.disabled,
.btn-primary[disabled] {
  background: var(--line-strong);
  color: var(--paper);
}
.btn-ghost {
  background: transparent;
  color: var(--ink-green);
  border: 2rpx solid var(--ink-green);
}

/* ---------- 状态: 「启事」栏目编排 ---------- */
.state-box {
  text-align: center;
  padding: 110rpx 40rpx 130rpx;
  border-top: 1rpx solid var(--line);
}
.state-kicker {
  display: block;
  font-size: var(--fs-label);
  letter-spacing: 12rpx;
  color: var(--ink-faint);
  margin-bottom: 26rpx;
}
.state-copy {
  font-family: var(--serif);
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: var(--ink);
}
.state-hint {
  display: block;
  margin-top: 18rpx;
  font-size: var(--fs-sub);
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}
.state-btn {
  display: inline-block;
  margin-top: 40rpx;
  border: 2rpx solid var(--ink-green);
  color: var(--ink-green);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  padding: 0 52rpx;
  min-height: 88rpx;
  line-height: 84rpx;
  border-radius: 2rpx;
}
.state-btn.danger {
  border-color: var(--seal);
  color: var(--seal);
}

/* ---------- 骨架屏: 「排字中」行线占位 ---------- */
.skel-row {
  display: flex;
  gap: 26rpx;
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.skel-box {
  width: 96rpx;
  height: 96rpx;
  background: var(--paper-deep);
  flex-shrink: 0;
  animation: skel-pulse 1.2s ease-in-out infinite alternate;
}
.skel-kicker {
  font-size: var(--fs-label);
  letter-spacing: 12rpx;
  color: var(--ink-faint);
  padding: 30rpx 4rpx 4rpx;
  text-align: center;
}
.skel-lines { flex: 1; padding-top: 8rpx; }
.skel-rule {
  height: 2rpx;
  background: var(--line-strong);
  margin-bottom: 26rpx;
  animation: skel-pulse 1.2s ease-in-out infinite alternate;
}
.skel-rule.w90 { width: 90%; }
.skel-rule.w70 { width: 70%; }
.skel-rule.w50 { width: 50%; margin-bottom: 0; }
@keyframes skel-pulse {
  from { opacity: 0.45; }
  to   { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .skel-box, .skel-rule { animation: none; }
}

/* ---------- 筛选底层与抽屉 ---------- */
.scrim {
  position: fixed;
  inset: 0;
  background: rgba(30, 28, 20, 0.45);   /* 暖黑, 保住纸张温度 */
  z-index: 90;
  animation: fade-in 0.2s ease-out;
}
.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: var(--paper);
  border-top: 6rpx double var(--ink-green);   /* 双线母题: 面板顶边 */
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  animation: slide-up 0.24s ease-out;
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 4rpx 4rpx 22rpx;
  border-bottom: 8rpx double var(--ink-green);
}
.sheet-title {
  font-family: var(--serif);
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  color: var(--ink);
}
.sheet-count {
  font-family: var(--mono);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--ink-soft);
}
@keyframes slide-up {
  from { transform: translateY(8%); opacity: 0.6; }
  to   { transform: translateY(0); opacity: 1; }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .sheet-panel, .scrim { animation: none; }
}

/* ---------- 通用 ---------- */
.container { padding: 24rpx 28rpx 48rpx; }
