/* 家教条目 —— 公报流水条目: 连续纸面 + 发丝线分隔 (无边框盒) */

.tutor-card {
  padding: 32rpx 4rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}

/* ---------- 印章样式 (组件样式隔离, 本地定义; 工艺同 app.wxss) ---------- */
.seal-ava {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--seal);
  color: #FBF7EF;
  font-family: var(--serif);
  font-weight: 900;
  border-radius: 2rpx;
  box-shadow:
    inset 0 0 0 3rpx rgba(251, 247, 239, 0.4),
    inset 0 0 0 6rpx rgba(181, 68, 45, 0.55),
    inset 0 0 14rpx rgba(112, 24, 10, 0.4);
}

.seal-badge {
  background: var(--seal);
  color: #FBF7EF;
  font-family: var(--serif);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 3rpx 10rpx;
  border-radius: 2rpx;
  box-shadow:
    inset 0 0 0 2rpx rgba(251, 247, 239, 0.45),
    inset 0 0 8rpx rgba(112, 24, 10, 0.35);
}

/* ---------- 头部: 篆印/档案照 + 宋体姓名 ---------- */
.tutor-header {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  margin-right: 26rpx;
  flex-shrink: 0;
  font-size: 44rpx;
}

.photo-frame {
  padding: 4rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--paper);
  box-sizing: content-box;
}
.photo-frame image {
  display: block;
  width: 96rpx;
  height: 96rpx;
}

.tutor-info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.name {
  font-family: var(--serif);
  font-size: var(--fs-name);
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.education {
  color: var(--ink-soft);
  font-size: var(--fs-sub);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.subjects {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

/* 铅字直角排印【数学】 (组件内本地定义) */
.subjects .subj {
  font-size: var(--fs-sub);
  color: var(--ink-green);
  letter-spacing: 1rpx;
}

/* ---------- 一行排印式统计（行情数字规范） ---------- */
.statline {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.statline .piece {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.statline .k {
  font-size: var(--fs-label);
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.statline .n {
  font-family: var(--serif);
  font-weight: 900;
  color: var(--ink);
  font-size: 30rpx;
  font-feature-settings: 'tnum';
  letter-spacing: 0;
}

.statline .u {
  font-size: var(--fs-label);
  color: var(--ink-faint);
}

.statline .dot {
  margin: 0 14rpx;
  color: var(--line-strong);
}

/* ---------- 本期推荐 (头条节奏: 粗墨条 + 大字 + 三行简介) ---------- */
.tutor-card.is-featured {
  border-left: 8rpx solid var(--ink-green);
  padding-left: 24rpx;
}
.tutor-card.is-featured .name {
  font-size: 46rpx;
  letter-spacing: 4rpx;
}
.featured-line {
  margin-bottom: 6rpx;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.featured-line .featured-kicker {
  font-size: 20rpx;
}
.tutor-card.is-featured .bio {
  -webkit-line-clamp: 3;
  font-size: 26rpx;
  line-height: 1.85;
  color: var(--ink);
}
.featured-kicker {
  font-family: var(--serif);
  font-size: 20rpx;
  color: var(--ink-green);
  letter-spacing: 6rpx;
  flex-shrink: 0;
}

/* ---------- 简介摘录 ---------- */
.tutor-footer {
  margin-top: 12rpx;
}

.bio {
  color: var(--ink-soft);
  font-size: var(--fs-label);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
