<view class="tutor-card" bindtap="onTap">
  <view class="tutor-header">
    <image wx:if="{{tutor.avatar}}" class="avatar photo-frame" src="{{tutor.avatar}}" mode="aspectFill"/>
    <view wx:else class="avatar seal-ava">{{tutor.name[0]}}</view>
    <view class="tutor-info">
      <view class="name-row">
        <text class="name">{{tutor.name}}</text>
        <view wx:if="{{tutor.verified}}" class="seal-badge">认证</view>
      </view>
      <view class="education">{{tutor.education}} · {{tutor.school}}</view>
      <view class="subjects">
        <text wx:for="{{tutor.subjects}}" wx:key="index" wx:for-item="subject" class="subj">【{{subject}}】</text>
      </view>
    </view>
  </view>

  <view class="statline">
    <view class="piece"><text class="k">评分</text><text class="n">{{tutor.rating || '暂无'}}</text></view>
    <text class="dot">·</text>
    <view class="piece"><text class="k">时薪</text><text class="n">{{tutor.hourlyRate}}</text><text class="u">元/时</text></view>
    <text class="dot">·</text>
    <view class="piece"><text class="k">教龄</text><text class="n">{{tutor.experience}} 年</text></view>
  </view>

  <view class="tutor-footer" wx:if="{{tutor.bio}}">
    <text class="bio">{{tutor.bio}}</text>
  </view>
</view>
