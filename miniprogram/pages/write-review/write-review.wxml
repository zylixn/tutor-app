<view class="container">
  <!-- 教师信息 -->
  <view class="tutor-info" wx:if="{{tutor}}">
    <image wx:if="{{tutor.avatar}}" class="avatar photo-frame" src="{{tutor.avatar}}" mode="aspectFill"/>
    <view wx:else class="avatar seal-ava">{{tutor.name[0]}}</view>
    <view class="info">
      <text class="name">{{tutor.name}}</text>
      <text class="education">{{tutor.education}} · {{tutor.school}}</text>
    </view>
  </view>

  <!-- 评分 -->
  <view class="section">
    <view class="sec-title">评分</view>
    <view class="star-row">
      <view class="stars">
        <view
          class="star {{index < rating ? 'active' : ''}}"
          wx:for="{{[1, 2, 3, 4, 5]}}"
          wx:key="*this"
          bindtap="onStarTap"
          data-rating="{{item}}"
        >
          <text>★</text>
        </view>
      </view>
      <text class="rating-text">{{ratingText}}</text>
    </view>
  </view>

  <!-- 评语内容 -->
  <view class="section">
    <view class="sec-title">评语内容</view>
    <view class="paper-grid">
      <textarea
        class="content-input"
        placeholder="请分享您的学习体验，帮助其他学员了解这位家教…"
        value="{{content}}"
        bindinput="onContentInput"
        maxlength="500"
        show-confirm-bar="{{false}}"
      />
      <view class="char-count">
        <text>{{content.length}}/500</text>
      </view>
    </view>
  </view>

  <!-- 匿名选项 -->
  <view class="anonymous-option" bindtap="toggleAnonymous">
    <view class="checkbox {{isAnonymous ? 'on' : ''}}">
      <text wx:if="{{isAnonymous}}" class="check-mark">✓</text>
    </view>
    <text>匿名评语</text>
  </view>

  <!-- 提交 -->
  <button class="submit-btn btn-primary {{canSubmit ? '' : 'disabled'}}" bindtap="onSubmit">
    存入公报
  </button>

  <!-- 档案脚注 -->
  <view class="page-folio">
    <text>本评语经核验后录入教学公报 · 可选择匿名刊出</text>
  </view>
</view>
