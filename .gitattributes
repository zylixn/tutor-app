# ============================================================
# 跨平台编码一致性规范
# 确保 macOS、Linux、Windows 统一使用 UTF-8 + LF 换行符
# ============================================================

# --- 默认规则 ---
# 自动检测文本文件，强制 LF 换行符（Windows 不自动转 CRLF）
* text=auto eol=lf

# --- 二进制文件（禁止 git 做换行符/编码转换） ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.jar binary
*.war binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.bz2 binary
*.xz binary
*.7z binary
*.class binary
*.o binary
*.obj binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.bin binary
*.pyc binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.wav binary
*.flac binary

# --- 脚本文件（务必 LF + UTF-8，Windows 不可转 CRLF） ---
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# --- 源代码 ---
*.java text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.go text eol=lf
*.scala text eol=lf

# --- 配置与数据文件 ---
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.conf text eol=lf

# --- 文档 ---
*.md text eol=lf
*.txt text eol=lf
*.adr text eol=lf
