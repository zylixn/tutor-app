#!/usr/bin/env bash
# pre-push hook: PM 推送审批令牌门禁（Challenge-Response 机制）
# 令牌必须匹配 Hook 生成的挑战码，AI 无法预知挑战码
# CI 环境通过 CLAUDE_PUSH_AUTO_APPROVE=1 自动批准
#
# 输入: git 通过 stdin 传递推送信息（每行: local-ref local-sha remote-ref remote-sha）

set -euo pipefail

# 读取推送信息（不使用，仅消费 stdin）
cat >/dev/null

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-.}"
cd "$PROJECT_DIR"

# CI 自动批准
if [ "${CLAUDE_PUSH_AUTO_APPROVE:-}" = "1" ]; then
    exit 0
fi

CHALLENGE_FILE=".claude/.push-challenge"
TOKEN_FILE=".claude/.push-approved"

SHORT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
COMMIT_SUBJECT=$(git log -1 --format="%s" 2>/dev/null || echo "unknown")

# TTL 检查（6 小时过期）
is_expired() {
    local file="$1"
    local max_age="${2:-21600}"
    local mtime=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0)
    local now=$(date +%s)
    local age=$(( now - mtime ))
    [ "$age" -gt "$max_age" ]
}

# 两个文件都存在，尝试匹配
if [ -f "$CHALLENGE_FILE" ] && [ -f "$TOKEN_FILE" ]; then
    CHALLENGE_CONTENT=$(cat "$CHALLENGE_FILE" 2>/dev/null || true)
    TOKEN_CONTENT=$(cat "$TOKEN_FILE" 2>/dev/null || true)

    CHALLENGE_NONCE=$(echo "$CHALLENGE_CONTENT" | cut -d: -f1)
    CHALLENGE_HASH=$(echo "$CHALLENGE_CONTENT" | cut -d: -f2)

    if is_expired "$CHALLENGE_FILE" 21600; then
        rm -f "$CHALLENGE_FILE" "$TOKEN_FILE"
        echo "🚫 挑战码已过期（>6小时），已清除。"
        echo "   请重新执行 git push 触发新挑战码，PM 批准后再推。"
        exit 1
    fi

    if [ "$TOKEN_CONTENT" = "$CHALLENGE_NONCE" ]; then
        if [ "$CHALLENGE_HASH" = "$SHORT_HASH" ]; then
            # 审批通过，清理文件
            rm -f "$CHALLENGE_FILE" "$TOKEN_FILE"
            exit 0
        else
            rm -f "$CHALLENGE_FILE" "$TOKEN_FILE"
            echo "🚫 HEAD 已变更（${CHALLENGE_HASH} → ${SHORT_HASH}），审批失效。"
            echo "   请重新执行 git push 触发新挑战码。"
            exit 1
        fi
    else
        rm -f "$TOKEN_FILE"
        echo "🚫 令牌与挑战码不匹配，已删除。"
        echo "   PM 回复「批准 ${CHALLENGE_NONCE}」，然后执行:"
        echo "   echo \"${CHALLENGE_NONCE}\" > .claude/.push-approved"
        exit 1
    fi
fi

# 只有令牌没有挑战码 → 非法
if [ -f "$TOKEN_FILE" ] && [ ! -f "$CHALLENGE_FILE" ]; then
    rm -f "$TOKEN_FILE"
    echo "🚫 挑战码已失效（无对应挑战码文件），已清除令牌。"
    echo "   请重新执行 git push 触发新挑战码。"
    exit 1
fi

# 挑战码存在且未过期且无令牌 → 提示先写 token
if [ -f "$CHALLENGE_FILE" ] && ! is_expired "$CHALLENGE_FILE" 21600; then
    CHALLENGE_CONTENT=$(cat "$CHALLENGE_FILE" 2>/dev/null || true)
    CHALLENGE_NONCE=$(echo "$CHALLENGE_CONTENT" | cut -d: -f1)
    CHALLENGE_HASH=$(echo "$CHALLENGE_CONTENT" | cut -d: -f2)

    if [ "$CHALLENGE_HASH" != "$SHORT_HASH" ]; then
        rm -f "$CHALLENGE_FILE"
        # fall through to generate new challenge
    else
        echo "⚠️ 挑战码 ${CHALLENGE_NONCE} 已生成但尚未写入 token。"
        echo "   PM 回复「批准 ${CHALLENGE_NONCE}」，然后执行:"
        echo "   echo \"${CHALLENGE_NONCE}\" > .claude/.push-approved"
        exit 1
    fi
fi

# 生成新挑战码
rm -f "$CHALLENGE_FILE" 2>/dev/null || true

NONCE=$(head -c 4 /dev/urandom | xxd -p)
TIMESTAMP=$(date +%s)

echo "${NONCE}:${SHORT_HASH}:${TIMESTAMP}" > "$CHALLENGE_FILE"

echo "🚫 推送需要审批 | 挑战码: ${NONCE} | HEAD: ${SHORT_HASH} | ${COMMIT_SUBJECT}"
echo "   PM 回复「批准 ${NONCE}」确认推送。"
echo "   ⚠️  push 完成前不得创建新 commit（否则挑战码失效）。"
echo "   收到批准后执行:"
echo "   echo \"${NONCE}\" > .claude/.push-approved"
exit 1
